<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>rocks.zapfast.ZapFast</id>
  <name>ZapExt</name>
  <summary>A community mod of ZapFast with extra desktop features</summary>
  <developer id="io.github.vitorhubdev">
    <name>vitorhubdev</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT</project_license>
  <description>
    <p>ZapExt is a community mod of ZapFast for Linux, macOS and Windows, written in Rust
    without a browser engine. Link your phone to read and send messages.</p>
    <p>Browse chats, search your local archive, send attachments and voice messages,
    and use emoji and stickers. Closing the window can keep the connection
    running in the system tray. ZapExt is an independent project, not affiliated
    with WhatsApp or Meta.</p>
  </description>
  <launchable type="desktop-id">rocks.zapfast.ZapFast.desktop</launchable>
  <url type="homepage">https://github.com/vitorhubdev/zapfast-extra</url>
  <url type="bugtracker">https://github.com/vitorhubdev/zapfast-extra/issues</url>
  <url type="help">https://github.com/vitorhubdev/zapfast-extra#readme</url>
  <url type="vcs-browser">https://github.com/vitorhubdev/zapfast-extra</url>
  <screenshots>
    <screenshot type="default">
      <caption>A conversation with pictures, voice messages and replies</caption>
      <image>https://raw.githubusercontent.com/vitorhubdev/zapfast-extra/main/docs/screenshot.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"><content_attribute id="social-chat">intense</content_attribute></content_rating>
  <requires>
    <display_length compare="ge">760</display_length>
    <internet>always</internet>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <releases>
    <release version="1.0.5" date="2026-09-17">
      <url>https://github.com/vitorhubdev/zapfast-extra/releases/tag/v1.0.5</url>
    </release>
    <release version="1.0.4" date="2026-09-16">
      <url>https://github.com/vitorhubdev/zapfast-extra/releases/tag/v1.0.4</url>
    </release>
  </releases>
</component>
