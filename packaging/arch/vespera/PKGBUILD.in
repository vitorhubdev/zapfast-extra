# Maintainer: Carmine Paolino <carmine@paolino.me>
pkgname=vespera
pkgver=@VERSION@
pkgrel=@PKGREL@
pkgdesc="Fast native WhatsApp client built with Rust and egui"
arch=('x86_64' 'aarch64')
url="https://github.com/vitorhubdev/Vespera"
license=('MIT')
install="${pkgname}.install"
depends=('alsa-lib' 'alsa-plugins' 'libglvnd' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr')
makedepends=('cargo' 'cmake' 'perl')
optdepends=('org.freedesktop.secrets: archive encryption key storage'
            'noto-fonts-emoji: colour emoji in messages and reactions'
            'xdg-desktop-portal: the file picker for attachments')
conflicts=('vespera-bin' 'vespera-git')
# !lto because ring compiles its own C and Arch's default CFLAGS put LTO
# objects in the archive, which lld then cannot resolve: the link fails on
# undefined ring_core_* symbols. The stable package is prebuilt and never
# meets this.
options=('!debug' '!lto')
source=("Vespera-${pkgver}.tar.gz::https://github.com/vitorhubdev/Vespera/archive/refs/tags/v${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

prepare() {
  cd "${srcdir}/Vespera-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # whatsapp-rust is a git dependency pinned to a commit; the lockfile
  # names it, so this fetches it along with everything else.
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "${srcdir}/Vespera-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # Generated bindings inside glutin carry the path they were built at, which
  # ends up in the binary and makes makepkg warn about a reference to $srcdir.
  # Appended rather than assigned, so the distro's own flags survive.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=${srcdir}=/"
  cargo build --frozen --release
}

check() {
  cd "${srcdir}/Vespera-${pkgver}"
  export RUSTUP_TOOLCHAIN=stable
  # The demo feature carries the headless layout test of every screen,
  # which needs no display and talks to nothing.
  cargo test --frozen --features demo
}

package() {
  cd "${srcdir}/Vespera-${pkgver}"

  install -Dm755 "target/release/vespera" "${pkgdir}/usr/bin/vespera"
  install -Dm644 "LICENSE" "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
  install -Dm644 "README.md" "${pkgdir}/usr/share/doc/${pkgname}/README.md"
  install -Dm644 "packaging/applications/vespera.desktop" \
    "${pkgdir}/usr/share/applications/vespera.desktop"
  install -Dm644 "packaging/icons/vespera.svg" \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/vespera.svg"
  # Releases predating theme integration remain valid packaging inputs.
  if [[ -f "contrib/omarchy/vespera.json.tpl" ]]; then
    install -Dm644 "contrib/omarchy/vespera.json.tpl" \
      "${pkgdir}/usr/share/vespera/omarchy/vespera.json.tpl"
    install -Dm755 "contrib/omarchy/vespera-theme" \
      "${pkgdir}/usr/share/vespera/omarchy/vespera-theme"
  fi

}
